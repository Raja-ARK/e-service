{
  "name": "@e-service/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./drizzle-orm": "./src/drizzle/orm.ts",
    "./drizzle-zod": "./src/drizzle/zod.ts",
    "./drizzle-core": "./src/drizzle/core.ts",
    "./zod-schemas/*": "./src/zod-schemas/*.ts"
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/seed/index.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@e-service/env": "workspace:*",
    "@e-service/shared": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@e-service/config": "workspace:*",
    "typescript": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
