{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "cd ../.. && bun --watch apps/server/src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@e-service/api": "workspace:*",
    "@e-service/auth": "workspace:*",
    "@e-service/db": "workspace:*",
    "@e-service/env": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@orpc/json-schema": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "catalog:",
    "zod": "catalog:",
    "@elysiajs/cors": "^1.4.2"
  },
  "devDependencies": {
    "@e-service/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "tsdown": "^0.21.10"
  }
}
